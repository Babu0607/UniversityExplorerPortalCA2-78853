@using UniversityExplorerPortalCA2_78853.Models

@if (Country != null)
{
    <div class="card shadow-sm p-4 mb-4 bg-light">
        <div class="row align-items-center">
            <div class="col-md-2 text-center">
                <span style="font-size: 3.5rem;">@Country.Flag</span>
            </div>
            <div class="col-md-10">
                <h4 class="mb-2"><strong>Country:</strong> @Country.Name</h4>
                <p class="mb-1"><strong>Capital:</strong> @Country.Capital</p>
                <p class="mb-1"><strong>Region:</strong> @Country.Region</p>
                <p class="mb-0"><strong>Population:</strong> @Country.Population</p>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Country? Country { get; set; }
}