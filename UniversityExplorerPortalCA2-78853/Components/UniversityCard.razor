@using UniversityExplorerPortalCA2_78853.Models

<div class="card h-100 shadow-sm">
    <div class="card-body d-flex flex-column">
        <h5 class="card-title text-primary">@University.Name</h5>
        <p class="card-text text-muted mb-2">@University.Country</p>

        @if (!string.IsNullOrEmpty(University.PrimaryWebsite))
        {
            <p class="mb-3">
                <a href="@University.PrimaryWebsite" target="_blank" rel="noopener" class="text-decoration-none">🌐 @University.PrimaryWebsite</a>
            </p>
        }

        <div class="mt-auto">
            <button class="btn btn-outline-primary btn-sm" @onclick="SelectUniversity">View Details</button>
        </div>
    </div>
</div>

@code {

    [Parameter] 
    public University University { get; set; } = new();
    
    [Parameter] 
    public EventCallback<University> OnSelect { get; set; }

    private Task SelectUniversity() => OnSelect.InvokeAsync(University);
    
}

