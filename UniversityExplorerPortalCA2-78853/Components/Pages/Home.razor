@page "/"

<PageTitle>University Explorer Portal</PageTitle>

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
    <div class="container-fluid py-5">
        <h1 class="display-5 fw-bold text-primary">University Explorer Portal</h1>
        <p class="col-md-8 fs-4 text-secondary">
            Welcome to your centralized platform for discovering universities worldwide
            through an integrated API mashup and managing your student applications seamlessly.
        </p>
        <hr class="my-4">
        <p>Use the navigation menu or the shortcut buttons below to get started:</p>
        <div class="d-flex flex-wrap gap-3">
            <a class="btn btn-primary btn-lg" href="university-explorer" role="button">Explore Universities</a>
            <a class="btn btn-outline-secondary btn-lg" href="student-applications" role="button">View Applications</a>
            <a class="btn btn-outline-success btn-lg" href="student-applications/create" role="button">New Application</a>
        </div>
    </div>
</div>