@page "/student-applications"
@rendermode InteractiveServer
@using UniversityExplorerPortalCA2_78853.Models
@using UniversityExplorerPortalCA2_78853.Services
@using UniversityExplorerPortalCA2_78853.Components
@inject StudentApplicationService StudentApplicationService
@inject NavigationManager Navigation

<PageTitle>Student Applications</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="text-primary mb-0">Student Applications</h3>
    <a href="/student-applications/create" class="btn btn-primary">Create New Application</a>
</div>

@if (_isLoading)
{
    <p class="text-info">Loading applications...</p>
}
else if (_hasError)
{
    <div class="alert alert-danger">
        Unable to retrieve data.
        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadAsync">Retry</button>
    </div>
}
else if (_applications.Count == 0)
{
    <div class="alert alert-warning">No student applications found. Try creating a new one!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Student Name</th>
                    <th>University</th>
                    <th>Country</th>
                    <th>Course</th>
                    <th>Application Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in _applications)
                {
                    <StudentApplicationRow @key="app.Id" Application="app" OnEdit="HandleEdit" />
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<StudentApplication> _applications = new();
    private bool _isLoading = true;
    private bool _hasError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _hasError = false;
        try
        {
            _applications = await StudentApplicationService.GetApplicationsAsync();
        }
        catch
        {
            _hasError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleEdit(StudentApplication app) =>
        Navigation.NavigateTo($"/student-applications/edit/{app.Id}");
}